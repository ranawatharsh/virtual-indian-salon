# Client env (build-time, Vite requires VITE_ prefix)
VITE_SERVER_URL=http://localhost:3001
# On hosts like Render, VITE_SERVER_HOST (bare host, no protocol) is auto-wired
# by render.yaml — the client builds https://<host> itself.
VITE_SERVER_HOST=
# Optional: pre-fill Spotify app Client ID (or enter it in the Jukebox UI)
VITE_SPOTIFY_CLIENT_ID=
